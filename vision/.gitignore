archive/workspace/**
!archive/workspace/.gitkeep

# Ultralytics / local weight downloads at repo root (use artifacts/ + download-model)
/*.pt
/*.onnx

# Rendered output may contain player names, chat, or notifications.
*.avi
*.mkv
*.mp4
*.mov
*.webm

